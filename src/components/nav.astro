---
import { Icon } from 'astro-icon/components'

import Button from '~/components/button.astro'

interface Props {
  edition?: string
  date?: Date
  venue?: string
}

const { edition, date, venue } = Astro.props
---

<nav class="top-0 z-50 sm:static sticky flex lg:flex-row flex-wrap lg:flex-nowrap justify-center sm:justify-between items-center bg-linear-to-r from-accent/80 via-primary/80 to-primary-lighter/80 sm:bg-none drop-shadow-md sm:drop-shadow-none backdrop-blur-sm sm:backdrop-blur-none lg:my-12 sm:px-4 lg:px-8 w-full">
  <a class="hidden sm:flex sm:justify-between lg:justify-start items-center mt-10 lg:mt-0 sm:pl-8 lg:grow lg:basis-0" href="/">
    <Icon class="w-12 h-12" name="icon-terminal" />
  </a>

  <a class="flex flex-auto justify-center order-first lg:order-none lg:mx-0 py-4 sm:py-4 lg:py-0 sm:border-primary/20 lg:border-0 sm:border-b overflow-x-auto font-mono text-white sm:text-primary text-sm text-center leading-relaxed basis-full lg:basis-auto" href="/">
   {date ? new Intl.DateTimeFormat('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(date) : new Date().getFullYear()}
    <span class="mx-2 text-white/60 sm:text-primary/40">{'|>'}</span>
    {venue || ''}
  </a>

  <div class="hidden sm:flex lg:justify-end mt-10 lg:mt-0 sm:pr-8 lg:grow lg:basis-0">
    <!-- {edition && <Button as="a" href={`https://tickets.execut.nl/${edition}/`}>
      Get your ticket!
    </Button>} -->
  </div>
</nav>
